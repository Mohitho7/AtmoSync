APP_ENV=development
LOG_LEVEL=INFO

# Local Kafka placeholder; no Kafka dependency or service is configured in DE-01.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Snowflake placeholders only. Never replace these with credentials in a tracked file.
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_AUTHENTICATOR=snowflake
SNOWFLAKE_ROLE=your_role
SNOWFLAKE_WAREHOUSE=ATMOSYNC_WH
SNOWFLAKE_DATABASE=ATMOSYNC
SNOWFLAKE_SCHEMA=RAW
